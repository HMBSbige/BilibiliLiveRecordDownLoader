<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:dialogs="using:BilibiliLiveRecordDownLoader.ViewModels.Dialogs"
    xmlns:views="using:BilibiliLiveRecordDownLoader.Views.Views"
    xmlns:cfg="using:BilibiliLiveRecordDownLoader.Domain.Shared.Configuration"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.RoomEditorView"
    x:DataType="dialogs:RoomEditorViewModel"
    Width="560">
    <UserControl.Styles>
        <Style Selector="NumericUpDown">
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0.#" />
            <Setter Property="Maximum" Value="86400" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="ItemTemplate" Value="{StaticResource LocalizedLabel}" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Classes="form" Margin="0,20,0,0">
            <Border Classes="errorBanner" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ic:FluentIcon Grid.Column="0" Icon="ErrorCircle" IconVariant="Filled" FontSize="16" Foreground="{DynamicResource SemiColorDanger}" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <StackPanel Classes="toolbar" HorizontalAlignment="Right">
                <Button Command="{Binding DismissDialogCommand}" Content="{Binding Cancel, Source={x:Static l:AppLanguage.Current}}" />
                <Button Theme="{DynamicResource SolidButton}" Classes="Primary" IsDefault="True" Command="{Binding SaveCommand}">
                    <StackPanel Classes="iconText">
                        <ProgressBar Theme="{DynamicResource ProgressRing}" IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsBusy}" />
                        <TextBlock Text="{Binding Save, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>

        <ScrollViewer MaxHeight="560">
            <StackPanel Classes="form" Margin="0,0,12,0" IsEnabled="{Binding !IsBusy}">
                <StackPanel Classes="field">
                    <TextBlock Text="{Binding RoomId, Source={x:Static l:AppLanguage.Current}}" />
                    <TextBox Text="{Binding RoomIdText}" IsEnabled="{Binding IsNew}" />
                    <TextBlock Classes="error" Text="{Binding RoomIdError}"
                               IsVisible="{Binding RoomIdError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <StackPanel Classes="toolbar" Spacing="24">
                    <CheckBox IsChecked="{Binding IsRecordingEnabled}" Content="{Binding RecordingEnabled, Source={x:Static l:AppLanguage.Current}}" />
                    <CheckBox IsChecked="{Binding IsDanmakuEnabled}" Content="{Binding RecordDanmaku, Source={x:Static l:AppLanguage.Current}}" />
                    <CheckBox IsChecked="{Binding IsNotificationEnabled}" Content="{Binding NotificationEnabled, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
                <Grid Classes="form" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Quality, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Quality}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RecorderType, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding RecorderTypeOptions}" SelectedItem="{Binding RecorderType}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Text="{Binding ConvertToMp4, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="3" Grid.Column="0" ItemsSource="{Binding ToggleOptions}" SelectedItem="{Binding ConvertToMp4}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Text="{Binding DeleteAfterConvert, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ToggleOptions}" SelectedItem="{Binding DeleteAfterConvert}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Text="{Binding RecordingSplit, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="5" Grid.Column="0" ItemsSource="{Binding SplitModeOptions}" SelectedItem="{Binding SplitMode}" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap" IsVisible="{Binding IsSplitByDuration}"
                               Text="{Binding SplitDuration, Source={x:Static l:AppLanguage.Current}}" />
                    <DockPanel Grid.Row="5" Grid.Column="1" IsVisible="{Binding IsSplitByDuration}">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Minutes, Source={x:Static l:AppLanguage.Current}}" />
                        <NumericUpDown Value="{Binding SplitDurationMinutes}" FormatString="0"
                                       Minimum="{x:Static cfg:RecordingSplitDefaults.MinDurationMinutes}" Maximum="{x:Static cfg:RecordingSplitDefaults.MaxDurationMinutes}" />
                    </DockPanel>
                    <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap" IsVisible="{Binding IsSplitBySize}"
                               Text="{Binding SplitSize, Source={x:Static l:AppLanguage.Current}}" />
                    <DockPanel Grid.Row="5" Grid.Column="1" IsVisible="{Binding IsSplitBySize}">
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Megabytes, Source={x:Static l:AppLanguage.Current}}" />
                        <NumericUpDown Value="{Binding SplitSizeMegabytes}" Increment="100" FormatString="0"
                                       Minimum="{x:Static cfg:RecordingSplitDefaults.MinSizeMegabytes}" Maximum="{x:Static cfg:RecordingSplitDefaults.MaxSizeMegabytes}" />
                    </DockPanel>
                    <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Text="{Binding SplitOnTitleChange, Source={x:Static l:AppLanguage.Current}}" />
                    <ComboBox Grid.Row="7" Grid.Column="0" ItemsSource="{Binding ToggleOptions}" SelectedItem="{Binding SplitOnTitleChange}" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Bottom" TextWrapping="Wrap"
                               Text="{Binding DanmakuOffset, Source={x:Static l:AppLanguage.Current}}" />
                    <NumericUpDown Grid.Row="7" Grid.Column="1" Value="{Binding DanmakuOffsetSeconds}" Increment="0.1" FormatString="0.###"
                                   Minimum="{x:Static cfg:DanmakuDefaults.MinOffsetSeconds}" Maximum="{x:Static cfg:DanmakuDefaults.MaxOffsetSeconds}"
                                   PlaceholderText="{Binding DanmakuOffsetPlaceholder}"
                                   AutomationProperties.Name="{Binding DanmakuOffset, Source={x:Static l:AppLanguage.Current}}" />
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Classes="field">
                        <CheckBox IsChecked="{Binding OverrideCodecPriority}" Content="{Binding CustomCodecPriority, Source={x:Static l:AppLanguage.Current}}" />
                        <views:PriorityListView DataContext="{Binding CodecPriority}" IsEnabled="{Binding $parent[UserControl].((dialogs:RoomEditorViewModel)DataContext).OverrideCodecPriority}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Classes="field">
                        <CheckBox IsChecked="{Binding OverrideFormatPriority}" Content="{Binding CustomFormatPriority, Source={x:Static l:AppLanguage.Current}}" />
                        <views:PriorityListView DataContext="{Binding FormatPriority}" IsEnabled="{Binding $parent[UserControl].((dialogs:RoomEditorViewModel)DataContext).OverrideFormatPriority}" />
                    </StackPanel>
                </Grid>
                <Expander Classes="inline" Header="{Binding Advanced, Source={x:Static l:AppLanguage.Current}}">
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                        <StackPanel Grid.Row="0" Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding StatusCheckInterval, Source={x:Static l:AppLanguage.Current}}" />
                            <NumericUpDown Value="{Binding StatusCheckIntervalSeconds}" Minimum="{x:Static cfg:RoomDefaults.MinStatusCheckIntervalSeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding DanmuReconnectDelay, Source={x:Static l:AppLanguage.Current}}" />
                            <NumericUpDown Value="{Binding DanmuReconnectDelaySeconds}" Minimum="{x:Static cfg:RoomDefaults.MinDanmuReconnectDelaySeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding StreamReconnectDelay, Source={x:Static l:AppLanguage.Current}}" />
                            <NumericUpDown Value="{Binding StreamReconnectDelaySeconds}" Minimum="{x:Static cfg:RoomDefaults.MinStreamReconnectDelaySeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding StreamConnectTimeout, Source={x:Static l:AppLanguage.Current}}" />
                            <NumericUpDown Value="{Binding StreamConnectTimeoutSeconds}" Minimum="{x:Static cfg:RoomDefaults.MinStreamConnectTimeoutSeconds}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding StreamIdleTimeout, Source={x:Static l:AppLanguage.Current}}" />
                            <NumericUpDown Value="{Binding StreamIdleTimeoutSeconds}" Minimum="{x:Static cfg:RoomDefaults.MinStreamIdleTimeoutSeconds}" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
