<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:common="using:BilibiliLiveRecordDownLoader.ViewModels.Common"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.PriorityListView"
    x:DataType="common:PriorityListViewModel">
    <Border Classes="table" Padding="4">
        <!-- 行本身没有自动化节点，按钮的说明里带上所属的项，读屏才分得清在移动哪一项 -->
        <ItemsControl x:Name="Items" ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="common:PriorityItemViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="8,0,4,0">
                        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Theme="{DynamicResource SubtleButton}" IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding #Items.((common:PriorityListViewModel)DataContext).MoveUpCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding MoveUp, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.Name="{Binding MoveUp, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.HelpText="{Binding Label}">
                            <ic:FluentIcon Icon="ArrowUp" FontSize="14" />
                        </Button>
                        <Button Grid.Column="2" Theme="{DynamicResource SubtleButton}" IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding #Items.((common:PriorityListViewModel)DataContext).MoveDownCommand, FallbackValue={x:Null}}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{Binding MoveDown, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.Name="{Binding MoveDown, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.HelpText="{Binding Label}">
                            <ic:FluentIcon Icon="ArrowDown" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
</UserControl>
