<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:tasks="using:BilibiliLiveRecordDownLoader.ViewModels.Tasks"
    xmlns:c="using:BilibiliLiveRecordDownLoader.Views.Converters"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.TasksView"
    x:DataType="tasks:TaskListViewModel">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Classes="toolbar" Margin="0,0,0,12">
            <Button Command="{Binding ClearFinishedTasksCommand}">
                <StackPanel Classes="iconText">
                    <ic:FluentIcon Icon="Broom" />
                    <TextBlock Text="{Binding ClearFinishedTasks, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Button>
            <Button Classes="Danger" Command="{Binding CancelAllTasksCommand}">
                <StackPanel Classes="iconText">
                    <ic:FluentIcon Icon="DismissCircle" />
                    <TextBlock Text="{Binding CancelAllTasks, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Panel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tasks:TaskItemViewModel">
                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <ContentControl Grid.Row="0" Grid.Column="1"
                                                    Content="{Binding Status}" ContentTemplate="{StaticResource LocalizedLabel}"
                                                    Foreground="{Binding Status, Converter={x:Static c:StatusBrushConverter.Instance}}" />
                                    <ProgressBar Grid.Row="1" Grid.Column="0"
                                                 Value="{Binding Progress}" Maximum="100"
                                                 IsIndeterminate="{Binding IsIndeterminate}" />
                                    <Button Grid.Row="1" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top"
                                            Theme="{DynamicResource BorderlessButton}"
                                            IsVisible="{Binding IsActive}"
                                            Command="{Binding $parent[ItemsControl].((tasks:TaskListViewModel)DataContext).CancelTaskCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding CancelTask, Source={x:Static l:AppLanguage.Current}}">
                                        <ic:FluentIcon Icon="Dismiss" />
                                    </Button>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding Message}" Classes="caption"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding NoTasks, Source={x:Static l:AppLanguage.Current}}"
                       Classes="caption"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsVisible="{Binding !HasTasks}" />
        </Panel>
    </DockPanel>
</UserControl>
