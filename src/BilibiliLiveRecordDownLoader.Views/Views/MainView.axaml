<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:vm="using:BilibiliLiveRecordDownLoader.ViewModels"
    xmlns:views="using:BilibiliLiveRecordDownLoader.Views.Views"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.MainView"
    x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="ListBox.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="ListBox.nav ic|FluentIcon">
            <Setter Property="FontSize" Value="20" />
        </Style>
        <Style Selector="ListBox.nav > ListBoxItem:selected ic|FluentIcon">
            <Setter Property="IconVariant" Value="Filled" />
        </Style>
        <Style Selector="ListBox.nav StackPanel.iconText">
            <Setter Property="Spacing" Value="12" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsInitialized}">
            <Border Grid.Column="0" Width="188" Padding="8,12"
                    Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="20,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="2" Margin="12,8"
                          IsVisible="{Binding Rooms.RecordingSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Ellipse Grid.Row="0" Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource SemiColorDanger}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Rooms.RecordingSummary}" TextTrimming="CharacterEllipsis"
                                   FontSize="{DynamicResource SemiFontSizeSmall}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="caption" Text="{Binding Rooms.RecordingSpeed}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ListBox x:Name="Navigation" Classes="nav" SelectedIndex="{Binding SelectedPageIndex, Mode=TwoWay}" SelectionChanged="OnNavigationSelectionChanged">
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Video" />
                                <TextBlock Text="{Binding Rooms, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="TaskList" />
                                <TextBlock Text="{Binding Tasks, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Wrench" />
                                <TextBlock Text="{Binding Tools, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="DocumentText" />
                                <TextBlock Text="{Binding Logs, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Person" />
                                <TextBlock Text="{Binding Account, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Settings" />
                                <TextBlock Text="{Binding Settings, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <Carousel Grid.Column="1" SelectedIndex="{Binding #Navigation.SelectedIndex}">
                <Carousel.PageTransition>
                    <CrossFade Duration="0:0:0.15" />
                </Carousel.PageTransition>
                <views:RoomsView DataContext="{Binding Rooms}" />
                <views:TasksView DataContext="{Binding Tasks}" />
                <views:ToolsView DataContext="{Binding Tools}" />
                <views:LogsView DataContext="{Binding Logs}" />
                <views:AccountView DataContext="{Binding Account}" />
                <views:SettingsView DataContext="{Binding Settings}" />
            </Carousel>
        </Grid>

        <ProgressBar Theme="{DynamicResource ProgressRing}" IsIndeterminate="True" Width="40" Height="40"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding !IsInitialized}" />
    </Panel>
</UserControl>
