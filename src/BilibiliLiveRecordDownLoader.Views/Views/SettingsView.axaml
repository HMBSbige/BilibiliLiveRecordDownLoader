<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:settings="using:BilibiliLiveRecordDownLoader.ViewModels.Settings"
    xmlns:views="using:BilibiliLiveRecordDownLoader.Views.Views"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.SettingsView"
    x:DataType="settings:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16" MaxWidth="900">
            <Border Classes="card" DataContext="{Binding General}">
                <StackPanel Classes="form" x:DataType="settings:GeneralSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding General, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding RecordDirectory, Source={x:Static l:AppLanguage.Current}}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Classes="toolbar" Margin="8,0,0,0">
                                <Button Command="{Binding BrowseRecordDirectoryCommand}" Content="{Binding Browse, Source={x:Static l:AppLanguage.Current}}" />
                                <Button Command="{Binding OpenRecordDirectoryCommand}" Content="{Binding Open, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                            <TextBox Text="{Binding RecordDirectory, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0"
                              IsVisible="{Binding DiskSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ProgressBar Grid.Column="0" Value="{Binding DiskUsagePercent}" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DiskSpaceText}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding FFmpegPath, Source={x:Static l:AppLanguage.Current}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding BrowseFFmpegPathCommand}"
                                    Content="{Binding Browse, Source={x:Static l:AppLanguage.Current}}" />
                            <TextBox Text="{Binding FFmpegPath, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding AutoDetect, Source={x:Static l:AppLanguage.Current}}" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Recording}">
                <StackPanel Classes="form" x:DataType="settings:RecordingSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding RecordingDefaults, Source={x:Static l:AppLanguage.Current}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding RecorderType, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding RecorderTypeOptions}"
                                      SelectedItem="{Binding RecorderType}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding StreamHostSelection, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding HostSelectionOptions}"
                                      SelectedItem="{Binding HostSelection}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding CodecPriority, Source={x:Static l:AppLanguage.Current}}" />
                            <views:PriorityListView DataContext="{Binding CodecPriority}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding FormatPriority, Source={x:Static l:AppLanguage.Current}}" />
                            <views:PriorityListView DataContext="{Binding FormatPriority}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding PriorityHint, Source={x:Static l:AppLanguage.Current}}" />
                    <CheckBox IsChecked="{Binding ConvertToMp4}" Content="{Binding ConvertToMp4, Source={x:Static l:AppLanguage.Current}}" />
                    <CheckBox IsChecked="{Binding DeleteAfterConvert}" IsEnabled="{Binding ConvertToMp4}"
                              Content="{Binding DeleteAfterConvert, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Network}">
                <StackPanel Classes="form" x:DataType="settings:NetworkSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Network, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding UserAgent, Source={x:Static l:AppLanguage.Current}}" />
                        <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Default, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                    <ToggleSwitch IsChecked="{Binding UseSystemProxy}"
                                  Content="{Binding UseSystemProxy, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Appearance}">
                <StackPanel Classes="form" x:DataType="settings:AppearanceSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Appearance, Source={x:Static l:AppLanguage.Current}}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding Theme, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Theme}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding Language, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="settings:LanguageOptionViewModel">
                                        <Panel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       IsVisible="{Binding CultureName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding FollowSystem, Source={x:Static l:AppLanguage.Current}}"
                                                       IsVisible="{Binding CultureName, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                        </Panel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch IsChecked="{Binding IsAutoStartEnabled}"
                                  IsVisible="{Binding IsAutoStartSupported}"
                                  Content="{Binding AutoStart, Source={x:Static l:AppLanguage.Current}}" />
                    <Button HorizontalAlignment="Left" Command="{Binding OpenConfigDirectoryCommand}">
                        <StackPanel Classes="iconText">
                            <ic:FluentIcon Icon="FolderOpen" />
                            <TextBlock Text="{Binding OpenConfigDirectory, Source={x:Static l:AppLanguage.Current}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Update}">
                <StackPanel Classes="form" x:DataType="settings:UpdateSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Update, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="toolbar">
                        <TextBlock Text="{Binding CurrentVersion, Source={x:Static l:AppLanguage.Current}}" />
                        <SelectableTextBlock Text="{Binding CurrentVersion}" />
                    </StackPanel>
                    <StackPanel Classes="toolbar" IsVisible="{Binding LatestVersion, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding LatestVersion, Source={x:Static l:AppLanguage.Current}}" />
                        <SelectableTextBlock Text="{Binding LatestVersion}" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding AutoCheckUpdate}" Content="{Binding AutoCheckUpdate, Source={x:Static l:AppLanguage.Current}}" />
                    <CheckBox IsChecked="{Binding IncludePreRelease}" Content="{Binding IncludePreRelease, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="toolbar">
                        <Button Theme="{DynamicResource SolidButton}" Classes="Primary" Command="{Binding CheckUpdateCommand}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="ArrowSync" />
                                <TextBlock Text="{Binding CheckUpdate, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenHomepageCommand}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Open" />
                                <TextBlock Text="{Binding OpenHomepage, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
