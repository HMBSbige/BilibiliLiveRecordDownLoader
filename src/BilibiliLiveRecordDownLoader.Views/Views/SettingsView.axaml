<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:settings="using:BilibiliLiveRecordDownLoader.ViewModels.Settings"
    xmlns:views="using:BilibiliLiveRecordDownLoader.Views.Views"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    xmlns:cfg="using:BilibiliLiveRecordDownLoader.Domain.Shared.Configuration"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.SettingsView"
    x:DataType="settings:SettingsViewModel">
    <UserControl.Styles>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <StackPanel Classes="page">
            <Border Classes="card" DataContext="{Binding General}">
                <StackPanel Classes="form" x:DataType="settings:GeneralSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding General, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding RecordDirectory, Source={x:Static l:AppLanguage.Current}}" />
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Classes="toolbar" Margin="8,0,0,0">
                                <Button Command="{Binding BrowseRecordDirectoryCommand}" Content="{Binding Browse, Source={x:Static l:AppLanguage.Current}}" />
                                <Button Command="{Binding OpenRecordDirectoryCommand}" Content="{Binding Open, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                            <TextBox Text="{Binding RecordDirectory, UpdateSourceTrigger=LostFocus}" />
                        </DockPanel>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0"
                              IsVisible="{Binding DiskSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <ProgressBar Grid.Column="0" Value="{Binding DiskUsagePercent}" Maximum="100" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DiskSpaceText}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding FFmpegPath, Source={x:Static l:AppLanguage.Current}}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding BrowseFFmpegPathCommand}"
                                    Content="{Binding Browse, Source={x:Static l:AppLanguage.Current}}" />
                            <TextBox Text="{Binding FFmpegPath, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding AutoDetect, Source={x:Static l:AppLanguage.Current}}" />
                        </DockPanel>
                    </StackPanel>
                    <ToggleSwitch IsChecked="{Binding IsAutoStartEnabled}"
                                  IsVisible="{Binding IsAutoStartSupported}"
                                  OnContent="{Binding AutoStart, Source={x:Static l:AppLanguage.Current}}"
                                  OffContent="{Binding AutoStart, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Recording}">
                <StackPanel Classes="form" x:DataType="settings:RecordingSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding RecordingDefaults, Source={x:Static l:AppLanguage.Current}}" />
                    <Grid Classes="form" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding RecorderType, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox ItemsSource="{Binding RecorderTypeOptions}" SelectedItem="{Binding RecorderType}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding StreamHostSelection, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox ItemsSource="{Binding HostSelectionOptions}" SelectedItem="{Binding HostSelection}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                    </Grid>
                    <Grid Classes="form" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding CodecPriority, Source={x:Static l:AppLanguage.Current}}" />
                            <views:PriorityListView DataContext="{Binding CodecPriority}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding FormatPriority, Source={x:Static l:AppLanguage.Current}}" />
                            <views:PriorityListView DataContext="{Binding FormatPriority}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Classes="caption" Margin="0,-8,0,0" Text="{Binding PriorityHint, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Spacing="8">
                        <ToggleSwitch IsChecked="{Binding ConvertToMp4}"
                                      OnContent="{Binding ConvertToMp4, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding ConvertToMp4, Source={x:Static l:AppLanguage.Current}}" />
                        <ToggleSwitch IsChecked="{Binding DeleteAfterConvert}" IsEnabled="{Binding ConvertToMp4}" Margin="24,0,0,0"
                                      OnContent="{Binding DeleteAfterConvert, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding DeleteAfterConvert, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                    <Grid Classes="form" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding RecordingSplit, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox ItemsSource="{Binding SplitModeOptions}" SelectedItem="{Binding SplitMode}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field" IsVisible="{Binding IsSplitByDuration}">
                            <TextBlock Text="{Binding SplitDuration, Source={x:Static l:AppLanguage.Current}}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Minutes, Source={x:Static l:AppLanguage.Current}}" />
                                <NumericUpDown Value="{Binding SplitDurationMinutes}" Increment="1" FormatString="0" HorizontalAlignment="Stretch"
                                               Minimum="{x:Static cfg:RecordingSplitDefaults.MinDurationMinutes}" Maximum="{x:Static cfg:RecordingSplitDefaults.MaxDurationMinutes}" />
                            </DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field" IsVisible="{Binding IsSplitBySize}">
                            <TextBlock Text="{Binding SplitSize, Source={x:Static l:AppLanguage.Current}}" />
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Megabytes, Source={x:Static l:AppLanguage.Current}}" />
                                <NumericUpDown Value="{Binding SplitSizeMegabytes}" Increment="100" FormatString="0" HorizontalAlignment="Stretch"
                                               Minimum="{x:Static cfg:RecordingSplitDefaults.MinSizeMegabytes}" Maximum="{x:Static cfg:RecordingSplitDefaults.MaxSizeMegabytes}" />
                            </DockPanel>
                        </StackPanel>
                    </Grid>
                    <ToggleSwitch IsChecked="{Binding SplitOnTitleChange}"
                                  OnContent="{Binding SplitOnTitleChange, Source={x:Static l:AppLanguage.Current}}"
                                  OffContent="{Binding SplitOnTitleChange, Source={x:Static l:AppLanguage.Current}}" />
                    <ToggleSwitch IsChecked="{Binding IncludeTitleInFileName}"
                                  OnContent="{Binding IncludeTitleInFileName, Source={x:Static l:AppLanguage.Current}}"
                                  OffContent="{Binding IncludeTitleInFileName, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Network}">
                <StackPanel Classes="form" x:DataType="settings:NetworkSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Network, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <TextBlock Text="{Binding UserAgent, Source={x:Static l:AppLanguage.Current}}" />
                        <TextBox Text="{Binding UserAgent, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding Default, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                    <ToggleSwitch IsChecked="{Binding UseSystemProxy}"
                                  OnContent="{Binding UseSystemProxy, Source={x:Static l:AppLanguage.Current}}"
                                  OffContent="{Binding UseSystemProxy, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Notification}">
                <StackPanel Classes="form" x:DataType="settings:NotificationSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Notifications, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <ToggleSwitch IsChecked="{Binding NotifyOnRecordingError}"
                                      AutomationProperties.Name="{Binding NotifyOnRecordingError, Source={x:Static l:AppLanguage.Current}}"
                                      AutomationProperties.HelpText="{Binding NotifyOnRecordingErrorHint, Source={x:Static l:AppLanguage.Current}}"
                                      OnContent="{Binding NotifyOnRecordingError, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding NotifyOnRecordingError, Source={x:Static l:AppLanguage.Current}}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding NotifyOnRecordingErrorHint, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                    <StackPanel Classes="field">
                        <ToggleSwitch IsChecked="{Binding NotifyOnTitleChange}"
                                      AutomationProperties.Name="{Binding NotifyOnTitleChange, Source={x:Static l:AppLanguage.Current}}"
                                      AutomationProperties.HelpText="{Binding NotifyOnTitleChangeHint, Source={x:Static l:AppLanguage.Current}}"
                                      OnContent="{Binding NotifyOnTitleChange, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding NotifyOnTitleChange, Source={x:Static l:AppLanguage.Current}}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding NotifyOnTitleChangeHint, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Appearance}">
                <StackPanel Classes="form" x:DataType="settings:AppearanceSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding Appearance, Source={x:Static l:AppLanguage.Current}}" />
                    <Grid Classes="form" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Classes="field">
                            <TextBlock Text="{Binding Theme, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}"
                                      ItemTemplate="{StaticResource LocalizedLabel}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Classes="field">
                            <TextBlock Text="{Binding Language, Source={x:Static l:AppLanguage.Current}}" />
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="settings:LanguageOptionViewModel">
                                        <Panel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       IsVisible="{Binding CultureName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding FollowSystem, Source={x:Static l:AppLanguage.Current}}"
                                                       IsVisible="{Binding CultureName, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                        </Panel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Experimental}">
                <StackPanel Classes="form" x:DataType="settings:ExperimentalSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding ExperimentalFeatures, Source={x:Static l:AppLanguage.Current}}" />
                    <StackPanel Classes="field">
                        <ToggleSwitch IsChecked="{Binding RemoveFillerData}"
                                      AutomationProperties.Name="{Binding RemoveFillerData, Source={x:Static l:AppLanguage.Current}}"
                                      AutomationProperties.HelpText="{Binding RemoveFillerDataHint, Source={x:Static l:AppLanguage.Current}}"
                                      OnContent="{Binding RemoveFillerData, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding RemoveFillerData, Source={x:Static l:AppLanguage.Current}}" />
                        <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RemoveFillerDataHint, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card" DataContext="{Binding Update}">
                <StackPanel Classes="form" x:DataType="settings:UpdateSettingsViewModel">
                    <TextBlock Classes="section" Text="{Binding About, Source={x:Static l:AppLanguage.Current}}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="12,0,0,0" Command="{Binding CheckUpdateCommand}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="ArrowSync" />
                                <TextBlock Text="{Binding CheckUpdate, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </Button>
                        <SelectableTextBlock VerticalAlignment="Center" Text="{Binding VersionText}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <StackPanel Spacing="8">
                        <ToggleSwitch IsChecked="{Binding AutoCheckUpdate}"
                                      OnContent="{Binding AutoCheckUpdate, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding AutoCheckUpdate, Source={x:Static l:AppLanguage.Current}}" />
                        <ToggleSwitch IsChecked="{Binding IncludePreRelease}"
                                      OnContent="{Binding IncludePreRelease, Source={x:Static l:AppLanguage.Current}}"
                                      OffContent="{Binding IncludePreRelease, Source={x:Static l:AppLanguage.Current}}" />
                    </StackPanel>
                    <StackPanel Classes="toolbar">
                        <Button Command="{Binding OpenHomepageCommand}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="Open" />
                                <TextBlock Text="{Binding OpenHomepage, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenConfigDirectoryCommand}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="FolderOpen" />
                                <TextBlock Text="{Binding OpenConfigDirectory, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
