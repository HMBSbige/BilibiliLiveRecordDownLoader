<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:dialogs="using:BilibiliLiveRecordDownLoader.ViewModels.Dialogs"
    xmlns:accounts="using:BilibiliLiveRecordDownLoader.Application.Contracts.Accounts"
    xmlns:c="using:BilibiliLiveRecordDownLoader.Views.Converters"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.QrCodeLoginView"
    x:DataType="dialogs:QrCodeLoginViewModel">
    <DockPanel>
        <StackPanel Classes="toolbar dialogFooter" HorizontalAlignment="Right">
            <Button Command="{Binding RefreshCommand}"
                    IsVisible="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static accounts:QrCodeLoginState.Expired}}">
                <StackPanel Classes="iconText">
                    <ic:FluentIcon Icon="ArrowSync" />
                    <TextBlock Text="{Binding Refresh, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding DismissDialogCommand}" Content="{Binding Cancel, Source={x:Static l:AppLanguage.Current}}" />
        </StackPanel>

        <StackPanel Spacing="16" HorizontalAlignment="Center">
            <Border Width="240" Height="240" CornerRadius="{DynamicResource ControlCornerRadius}" Background="White" Padding="8" HorizontalAlignment="Center">
                <Panel>
                    <Image Source="{Binding QrCodeUrl, Converter={x:Static c:QrCodeImageConverter.Instance}}"
                           RenderOptions.BitmapInterpolationMode="None" />
                    <ProgressBar IsIndeterminate="True" Theme="{DynamicResource ProgressRing}" Width="48" Height="48"
                                 IsVisible="{Binding IsLoadingQrCode}" />
                </Panel>
            </Border>
            <ContentControl HorizontalAlignment="Center"
                            Content="{Binding State}"
                            ContentTemplate="{StaticResource LocalizedLabel}"
                            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
            <TextBlock Classes="error" MaxWidth="240" TextAlignment="Center" Text="{Binding ErrorMessage}"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </DockPanel>
</UserControl>
