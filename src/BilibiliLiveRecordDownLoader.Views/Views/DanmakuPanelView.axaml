<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:danmaku="using:BilibiliLiveRecordDownLoader.ViewModels.Danmaku"
    xmlns:platform="using:BilibiliLiveRecordDownLoader.Application.Contracts.Platform"
    xmlns:cfg="using:BilibiliLiveRecordDownLoader.Domain.Shared.Configuration"
    xmlns:ctl="using:BilibiliLiveRecordDownLoader.Views.Controls"
    xmlns:conv="using:BilibiliLiveRecordDownLoader.Views.Converters"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.DanmakuPanelView"
    x:DataType="danmaku:DanmakuPanelViewModel">
    <UserControl.Styles>
        <Style Selector="Border.panelHeader">
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="12,6,6,6" />
        </Style>
        <Style Selector="ToggleButton.chip">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        </Style>
        <Style Selector="ListBox.danmaku">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0,4" />
        </Style>
        <Style Selector="ListBox.danmaku > ListBoxItem">
            <Setter Property="Padding" Value="12,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- 列表项的内容是视图模型，读屏念整行的文字 -->
        <Style Selector="ListBox.danmaku > ListBoxItem" x:DataType="danmaku:DanmakuEntryViewModel">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="Border.badge.guard">
            <Setter Property="Background" Value="{DynamicResource GuardBadgeBackground}" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.badge.unlit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.badge.unlit > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.storm">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <!-- 被直播间删掉的 SC 留着可查 -->
        <Style Selector="Border.superChat.deleted">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Border.superChat.deleted TextBlock.superChatText">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- 两个主题都用浅色主题的主色：深色主题的主色太浅，白字看不清 -->
        <SolidColorBrush x:Key="GuardBadgeBackground" Color="#0064FA" />
        <SolidColorBrush x:Key="DensityFillBrush" Color="{DynamicResource SystemAccentColor}" Opacity="0.2" />
        <DataTemplate x:Key="DanmakuEntry" x:DataType="danmaku:DanmakuEntryViewModel">
            <Panel>
                <!-- 各档 SC 上半部分都是浅底，文字用固定深色 -->
                <Border Classes="superChat" Classes.deleted="{Binding IsDeleted}" IsVisible="{Binding IsSuperChat}" CornerRadius="{DynamicResource ControlCornerRadius}" ClipToBounds="True" Margin="0,2">
                    <StackPanel>
                        <Border Background="{Binding SuperChatBackground, Converter={x:Static conv:RgbBrushConverter.Instance}}" Padding="8,4">
                            <DockPanel HorizontalSpacing="8">
                                <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Text="{Binding PriceText}"
                                           Foreground="{Binding SuperChatPriceColor, Converter={x:Static conv:RgbBrushConverter.Instance}}" />
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="#666666" IsVisible="{Binding IsDeleted}"
                                           Text="{Binding DanmakuSuperChatDeleted, Source={x:Static l:AppLanguage.Current}}" />
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="{DynamicResource CaptionFontSize}"
                                           Foreground="#666666" Text="{Binding TimeText}" />
                                <TextBlock FontWeight="SemiBold" Foreground="#333333" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                            </DockPanel>
                        </Border>
                        <Border Background="{Binding SuperChatBottomBackground, Converter={x:Static conv:RgbBrushConverter.Instance}}" Padding="8,4">
                            <TextBlock Classes="superChatText" TextWrapping="Wrap" Text="{Binding Text}"
                                       Foreground="{Binding SuperChatTextColor, Converter={x:Static conv:RgbBrushConverter.Instance}}" />
                        </Border>
                    </StackPanel>
                </Border>
                <Grid IsVisible="{Binding !IsSuperChat}" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0" Classes="caption" Text="{Binding TimeText}" />
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Classes.storm="{Binding IsStorm}" Classes.notice="{Binding IsNotice}">
                        <InlineUIContainer BaselineAlignment="Center">
                            <Border Classes="badge" Classes.guard="{Binding IsGuardBadge}" Classes.unlit="{Binding IsUnlitMedal}"
                                    Background="{Binding MedalColor, Converter={x:Static conv:RgbBrushConverter.Instance}}"
                                    IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Badge}" />
                            </Border>
                        </InlineUIContainer>
                        <Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Name}" /><Run Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding NameSeparator}" /><Run Text="{Binding Text}" />
                        <Run Foreground="{DynamicResource SystemFillColorCautionBrush}" FontWeight="SemiBold" Text="{Binding PriceText}" />
                    </TextBlock>
                </Grid>
            </Panel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataTemplates>
        <DataTemplate DataType="danmaku:DanmakuFilterViewModel">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton Classes="chip" IsChecked="{Binding ShowComments}" Content="{Binding DanmakuComments, Source={x:Static l:AppLanguage.Current}}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding ShowSuperChats}" Content="{Binding DanmakuSuperChats, Source={x:Static l:AppLanguage.Current}}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding ShowGifts}" Content="{Binding DanmakuGifts, Source={x:Static l:AppLanguage.Current}}" />
                    <ToggleButton Classes="chip" IsChecked="{Binding ShowGuards}" Content="{Binding DanmakuGuards, Source={x:Static l:AppLanguage.Current}}" />
                </StackPanel>
                <TextBox Classes="search clearButton" Text="{Binding SearchText}"
                         PlaceholderText="{Binding SearchDanmaku, Source={x:Static l:AppLanguage.Current}}"
                         AutomationProperties.Name="{Binding SearchDanmaku, Source={x:Static l:AppLanguage.Current}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Border Classes="table">
        <DockPanel>
            <Border DockPanel.Dock="Top" Classes="panelHeader">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                        <Button Classes="icon" Command="{Binding CloseFileCommand}"
                                IsVisible="{Binding File, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="{Binding BackToLiveDanmaku, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.Name="{Binding BackToLiveDanmaku, Source={x:Static l:AppLanguage.Current}}">
                            <ic:FluentIcon Icon="ChatMultiple" />
                        </Button>
                        <Button Classes="icon" Command="{Binding OpenFileCommand}"
                                ToolTip.Tip="{Binding OpenDanmakuFile, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.Name="{Binding OpenDanmakuFile, Source={x:Static l:AppLanguage.Current}}">
                            <ic:FluentIcon Icon="FolderOpen" />
                        </Button>
                        <Button Classes="icon" Command="{Binding CloseCommand}"
                                ToolTip.Tip="{Binding Close, Source={x:Static l:AppLanguage.Current}}"
                                AutomationProperties.Name="{Binding Close, Source={x:Static l:AppLanguage.Current}}">
                            <ic:FluentIcon Icon="Dismiss" />
                        </Button>
                    </StackPanel>
                    <Panel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Text="{Binding File.FileName, FallbackValue={x:Null}}" ToolTip.Tip="{Binding File.Path, FallbackValue={x:Null}}"
                                   IsVisible="{Binding File, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <!-- 靠左只取需要的宽度，在录的标记才能紧跟在名称后面 -->
                        <DockPanel HorizontalAlignment="Left" HorizontalSpacing="8">
                            <DockPanel.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="File" Converter="{x:Static ObjectConverters.IsNull}" />
                                    <Binding Path="Room" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                </MultiBinding>
                            </DockPanel.IsVisible>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                        IsVisible="{Binding Room.IsRecordingDanmaku, FallbackValue={x:False}}">
                                <ic:FluentIcon Icon="CommentMultiple" IconVariant="Filled" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding RecordingDanmaku, Source={x:Static l:AppLanguage.Current}}" />
                            </StackPanel>
                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Room.DisplayName, FallbackValue={x:Null}}" />
                        </DockPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Danmaku, Source={x:Static l:AppLanguage.Current}}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static ObjectConverters.AreAllNull}">
                                    <Binding Path="File" />
                                    <Binding Path="Room" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>
                    </Panel>
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Top" Classes="errorBanner" Margin="12,8,12,0"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ic:FluentIcon Grid.Column="0" Icon="ErrorCircle" />
                    <SelectableTextBlock Grid.Column="1" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Panel>
                <DockPanel DataContext="{Binding Live}" x:DataType="danmaku:LiveDanmakuViewModel"
                           IsVisible="{Binding $parent[UserControl].((danmaku:DanmakuPanelViewModel)DataContext).Live, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue={x:False}}">
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0" Spacing="2">
                        <DockPanel HorizontalSpacing="8">
                            <TextBlock DockPanel.Dock="Right" Classes="caption" VerticalAlignment="Center" Text="{Binding RateText}" />
                            <!-- 身份文字放在星号列里才会截断，横向 StackPanel 按无限宽测量 -->
                            <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" ctl:StatusColor.Value="{Binding State}" />
                                <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="{Binding StateText}" />
                                <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="·"
                                           IsVisible="{Binding IdentityText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <DockPanel Grid.Column="3" HorizontalAlignment="Left">
                                    <Button DockPanel.Dock="Right" Theme="{DynamicResource SubtleButton}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Padding="4,0" Margin="2,0,0,0"
                                            MinHeight="0" VerticalAlignment="Center"
                                            FontSize="{DynamicResource CaptionFontSize}" IsVisible="{Binding CanLogin}"
                                            Command="{Binding $parent[UserControl].((danmaku:DanmakuPanelViewModel)DataContext).LoginCommand, FallbackValue={x:Null}}"
                                            Content="{Binding Login, Source={x:Static l:AppLanguage.Current}}" />
                                    <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding IdentityText}" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding IdentityText}" />
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                        <TextBlock Classes="caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Text="{Binding ReconnectingText}"
                                   IsVisible="{Binding ReconnectingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <ContentControl DockPanel.Dock="Top" Margin="12,8" Content="{Binding Filter}" />

                    <Panel>
                        <ListBox x:Name="LiveList" Classes="danmaku" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource DanmakuEntry}"
                                 IsVisible="{Binding HasVisibleEntries}" />
                        <ctl:EmptyState Icon="ChatMultiple"
                                        Title="{Binding NoDanmaku, Source={x:Static l:AppLanguage.Current}}"
                                        Description="{Binding NoDanmakuHint, Source={x:Static l:AppLanguage.Current}}"
                                        IsVisible="{Binding !HasEntries}" />
                        <ctl:EmptyState Icon="DocumentSearch" Title="{Binding NoMatchingDanmaku, Source={x:Static l:AppLanguage.Current}}">
                            <ctl:EmptyState.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasEntries" />
                                    <Binding Path="!HasVisibleEntries" />
                                </MultiBinding>
                            </ctl:EmptyState.IsVisible>
                        </ctl:EmptyState>
                        <Button Classes="accent" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                Command="{Binding ScrollToLatestCommand}"
                                IsVisible="{Binding NewEntriesText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Classes="iconText">
                                <ic:FluentIcon Icon="ArrowDown" />
                                <TextBlock Text="{Binding NewEntriesText}" />
                            </StackPanel>
                        </Button>
                    </Panel>
                </DockPanel>

                <DockPanel DataContext="{Binding File}" x:DataType="danmaku:DanmakuFileViewModel"
                           IsVisible="{Binding $parent[UserControl].((danmaku:DanmakuPanelViewModel)DataContext).File, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue={x:False}}">
                    <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding Summary}" ToolTip.Tip="{Binding Summary}" />
                            <TextBlock Classes="caption" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Text="{Binding Notice}"
                                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                        <ctl:DanmakuDensityChart Height="56"
                                                 Density="{Binding Density}" Highlights="{Binding Highlights}" Duration="{Binding Duration}"
                                                 Position="{Binding SelectedEntry.Time, FallbackValue={x:Null}}" Command="{Binding JumpToCommand}"
                                                 Fill="{DynamicResource DensityFillBrush}" Stroke="{DynamicResource AccentFillColorDefaultBrush}"
                                                 HighlightBrush="{DynamicResource SystemFillColorCautionBrush}" PeakBrush="{DynamicResource SystemFillColorCautionBrush}"
                                                 PositionBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                 IsVisible="{Binding HasEntries}"
                                                 AutomationProperties.Name="{Binding DanmakuHighlights, Source={x:Static l:AppLanguage.Current}}" />
                        <StackPanel Spacing="2" IsVisible="{Binding HasHighlights}">
                            <TextBlock Classes="caption" FontWeight="SemiBold" Text="{Binding DanmakuHighlights, Source={x:Static l:AppLanguage.Current}}" />
                            <ScrollViewer MaxHeight="128">
                                <ItemsControl ItemsSource="{Binding Highlights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="danmaku:DanmakuHighlightViewModel">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Classes="icon"
                                                        Command="{Binding $parent[ItemsControl].((danmaku:DanmakuFileViewModel)DataContext).ExportHighlightCommand, FallbackValue={x:Null}}"
                                                        CommandParameter="{Binding}"
                                                        IsVisible="{Binding $parent[ItemsControl].((danmaku:DanmakuFileViewModel)DataContext).HasVideo, FallbackValue={x:False}}"
                                                        ToolTip.Tip="{Binding ExportHighlight, Source={x:Static l:AppLanguage.Current}}"
                                                        AutomationProperties.Name="{Binding ExportHighlight, Source={x:Static l:AppLanguage.Current}}"
                                                        AutomationProperties.HelpText="{Binding Phrase}">
                                                    <ic:FluentIcon Icon="Cut" />
                                                </Button>
                                                <Button Theme="{DynamicResource SubtleButton}" Padding="4,2" MinHeight="0"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                        Command="{Binding $parent[ItemsControl].((danmaku:DanmakuFileViewModel)DataContext).JumpToCommand, FallbackValue={x:Null}}"
                                                        CommandParameter="{Binding Start}"
                                                        AutomationProperties.Name="{Binding Phrase}" AutomationProperties.HelpText="{Binding TimeText}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Classes="caption" VerticalAlignment="Center" Text="{Binding TimeText}" />
                                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="Normal" Text="{Binding Phrase}" ToolTip.Tip="{Binding Phrase}" />
                                                    </Grid>
                                                </Button>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8" Spacing="8">
                        <Border Classes="messageBanner"
                                Classes.successBanner="{Binding MessageType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static platform:AppNotificationType.Success}}"
                                Classes.warningBanner="{Binding MessageType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static platform:AppNotificationType.Warning}}"
                                Classes.errorBanner="{Binding MessageType, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static platform:AppNotificationType.Error}}"
                                IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <SelectableTextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Classes="field" IsVisible="{Binding CanAdjustOffset}">
                            <TextBlock Classes="caption" Text="{Binding DanmakuOffset, Source={x:Static l:AppLanguage.Current}}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding RegenerateCommand}"
                                        ToolTip.Tip="{Binding RegenerateDanmakuHint, Source={x:Static l:AppLanguage.Current}}">
                                    <StackPanel Classes="iconText">
                                        <ProgressBar Theme="{DynamicResource ProgressRing}" IsIndeterminate="True" Width="14" Height="14" IsVisible="{Binding IsBusy}" />
                                        <ic:FluentIcon Icon="ArrowSync" IsVisible="{Binding !IsBusy}" />
                                        <TextBlock Text="{Binding RegenerateDanmaku, Source={x:Static l:AppLanguage.Current}}" />
                                    </StackPanel>
                                </Button>
                                <NumericUpDown Value="{Binding OffsetSeconds}" Increment="0.1" FormatString="0.###" HorizontalAlignment="Stretch"
                                               Minimum="{x:Static cfg:DanmakuDefaults.MinOffsetSeconds}" Maximum="{x:Static cfg:DanmakuDefaults.MaxOffsetSeconds}"
                                               IsEnabled="{Binding !IsBusy}" />
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <ContentControl DockPanel.Dock="Top" Margin="12,8" Content="{Binding Filter}" />

                    <Panel>
                        <ListBox Classes="danmaku" ItemsSource="{Binding Entries}" ItemTemplate="{StaticResource DanmakuEntry}"
                                 SelectedItem="{Binding SelectedEntry}" IsVisible="{Binding HasVisibleEntries}" />
                        <ctl:EmptyState Icon="DocumentSearch" Title="{Binding NoMatchingDanmaku, Source={x:Static l:AppLanguage.Current}}">
                            <ctl:EmptyState.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="HasEntries" />
                                    <Binding Path="!HasVisibleEntries" />
                                </MultiBinding>
                            </ctl:EmptyState.IsVisible>
                        </ctl:EmptyState>
                        <ctl:EmptyState Icon="ChatMultiple" Title="{Binding NoDanmaku, Source={x:Static l:AppLanguage.Current}}"
                                        IsVisible="{Binding !HasEntries}" />
                    </Panel>
                </DockPanel>

                <ctl:EmptyState Icon="ChatMultiple" Title="{Binding SelectRoomForDanmaku, Source={x:Static l:AppLanguage.Current}}">
                    <ctl:EmptyState.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="Live" Converter="{x:Static ObjectConverters.IsNull}" />
                            <Binding Path="File" Converter="{x:Static ObjectConverters.IsNull}" />
                            <Binding Path="!IsLoadingFile" />
                        </MultiBinding>
                    </ctl:EmptyState.IsVisible>
                </ctl:EmptyState>
                <ProgressBar Theme="{DynamicResource ProgressRing}" IsIndeterminate="True" Width="40" Height="40"
                             HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsLoadingFile}" />
            </Panel>
        </DockPanel>
    </Border>
</UserControl>
