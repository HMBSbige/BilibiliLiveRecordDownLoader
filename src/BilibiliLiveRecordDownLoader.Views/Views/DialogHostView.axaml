<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia"
    xmlns:dialogs="using:BilibiliLiveRecordDownLoader.ViewModels.Dialogs"
    xmlns:views="using:BilibiliLiveRecordDownLoader.Views.Views"
    xmlns:l="using:BilibiliLiveRecordDownLoader.Domain.Shared.Localization"
    x:Class="BilibiliLiveRecordDownLoader.Views.Views.DialogHostView"
    x:DataType="dialogs:DialogHostViewModel"
    IsVisible="{Binding Current, Converter={x:Static ObjectConverters.IsNotNull}}">
    <Panel>
        <Border Background="{DynamicResource SmokeFillColorDefaultBrush}" PointerPressed="OnOverlayPressed">
            <Border.BackdropEffect>
                <BlurEffect Radius="16" />
            </Border.BackdropEffect>
        </Border>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                MinWidth="380" MaxWidth="720" Margin="32"
                Padding="24" CornerRadius="{DynamicResource OverlayCornerRadius}"
                Background="{DynamicResource SolidBackgroundFillColorQuarternaryBrush}"
                BoxShadow="{DynamicResource ElevatedShadow}"
                KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel VerticalSpacing="16">
                <DockPanel DockPanel.Dock="Top" HorizontalSpacing="8">
                    <Button DockPanel.Dock="Right" Theme="{DynamicResource SubtleButton}" Command="{Binding Current.DismissDialogCommand, FallbackValue={x:Null}}"
                            ToolTip.Tip="{Binding Close, Source={x:Static l:AppLanguage.Current}}"
                            AutomationProperties.Name="{Binding Close, Source={x:Static l:AppLanguage.Current}}">
                        <ic:FluentIcon Icon="Dismiss" />
                    </Button>
                    <TextBlock Classes="title" Text="{Binding Current.Title, FallbackValue={x:Null}}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
                <ContentControl x:Name="DialogContent" Content="{Binding Current}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="dialogs:ConfirmDialogViewModel">
                            <views:ConfirmDialogView />
                        </DataTemplate>
                        <DataTemplate DataType="dialogs:RoomEditorViewModel">
                            <views:RoomEditorView />
                        </DataTemplate>
                        <DataTemplate DataType="dialogs:QrCodeLoginViewModel">
                            <views:QrCodeLoginView />
                        </DataTemplate>
                        <DataTemplate DataType="dialogs:FollowedRoomImportViewModel">
                            <views:FollowedRoomImportView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
