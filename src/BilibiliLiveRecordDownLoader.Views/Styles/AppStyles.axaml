<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:ctl="using:BilibiliLiveRecordDownLoader.Views.Controls">
    <Styles.Resources>
        <Thickness x:Key="PageMargin">16</Thickness>
        <Thickness x:Key="CardPadding">16</Thickness>
        <x:Double x:Key="PageSpacing">24</x:Double>
        <!-- 表单页放在限宽的靠左列里：宽屏下行不会太长，左边线也和列表页一致 -->
        <x:Double x:Key="PageMaxWidth">1000</x:Double>
        <x:Double x:Key="FormSpacing">12</x:Double>
        <x:Double x:Key="FieldSpacing">4</x:Double>
        <x:Double x:Key="ToolbarSpacing">8</x:Double>
        <x:Double x:Key="CaptionFontSize">12</x:Double>
        <BoxShadows x:Key="ElevatedShadow">0 8 32 0 #3D000000</BoxShadows>

        <!-- Fluent2 只有默认和 accent 两种按钮，透明底的图标、链接类按钮要自己定义 -->
        <ControlTheme x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource ButtonThemeBorderThickness}" />
            <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
            <Setter Property="Padding" Value="{DynamicResource ButtonPadding}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
            </Style>
            <Style Selector="^:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
        </ControlTheme>

        <!-- Fluent2 没有环形进度。旋转角和起始角一个周期合计转过 360°，循环衔接处不跳 -->
        <ControlTheme x:Key="ProgressRing" TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <!-- ProgressBar 要求模板里有这个部件，环形样式用不到 -->
                        <Border x:Name="PART_Indicator" IsVisible="False" />
                        <Viewbox>
                            <Arc x:Name="Indicator" Width="32" Height="32" StrokeThickness="3.5" StrokeLineCap="Round"
                                 Stroke="{TemplateBinding Foreground}" StartAngle="-90" SweepAngle="270" />
                        </Viewbox>
                    </Panel>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:indeterminate /template/ Arc#Indicator">
                <Style.Animations>
                    <Animation Duration="0:0:1.6" IterationCount="Infinite">
                        <KeyFrame Cue="0%">
                            <Setter Property="RotateTransform.Angle" Value="0" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="RotateTransform.Angle" Value="150" />
                        </KeyFrame>
                    </Animation>
                    <Animation Duration="0:0:1.6" IterationCount="Infinite" Easing="SineEaseInOut">
                        <KeyFrame Cue="0%">
                            <Setter Property="StartAngle" Value="-90" />
                            <Setter Property="SweepAngle" Value="30" />
                        </KeyFrame>
                        <KeyFrame Cue="50%">
                            <Setter Property="StartAngle" Value="-90" />
                            <Setter Property="SweepAngle" Value="240" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="StartAngle" Value="120" />
                            <Setter Property="SweepAngle" Value="30" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ctl:EmptyState}" TargetType="ctl:EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="8" MaxWidth="360">
                        <ic:FluentIcon Icon="{TemplateBinding Icon}" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Classes="section" Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{TemplateBinding Description}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" Margin="0,8,0,0"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type ctl:SettingRow}" TargetType="ctl:SettingRow">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- 最小高度取输入框的高度，开关行和下拉框行一样高 -->
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24" MinHeight="32">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap"
                                           IsVisible="{TemplateBinding Header, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Classes="caption" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                                           IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_ContentPresenter" Grid.Column="1" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^.stacked /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Grid.ColumnSpan" Value="2" />
            </Style>
            <Style Selector="^.stacked:labeled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Margin" Value="0,8,0,0" />
            </Style>
            <!-- 标题和说明不在控件里，不会随控件一起变淡 -->
            <Style Selector="^:disabled /template/ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
            </Style>
            <!-- 依赖上一行开关的子设置 -->
            <Style Selector="^.nested">
                <Setter Property="Padding" Value="40,12,16,12" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector=":is(Panel).page">
        <Setter Property="Margin" Value="{StaticResource PageMargin}" />
    </Style>
    <Style Selector="StackPanel.page">
        <Setter Property="Spacing" Value="{StaticResource PageSpacing}" />
    </Style>
    <Style Selector="DockPanel.page">
        <Setter Property="VerticalSpacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="DockPanel.toolbar">
        <Setter Property="Dock" Value="Top" />
        <Setter Property="HorizontalSpacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.toolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector=":is(Panel).dialogFooter">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <!-- 窗口底色是灰的，卡片和表格铺一层卡片底色才从页面上浮起来 -->
    <Style Selector="Border.card, Border.table">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style Selector="StackPanel.form">
        <Setter Property="Spacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="Grid.form">
        <Setter Property="ColumnSpacing" Value="{StaticResource FormSpacing}" />
        <Setter Property="RowSpacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="{StaticResource FieldSpacing}" />
    </Style>
    <Style Selector="StackPanel.field > DockPanel, Grid.form > DockPanel">
        <Setter Property="HorizontalSpacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.field > TextBlock.caption">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 字段的第一个子元素是标签，读屏时随输入控件一起读出 -->
    <Style Selector="StackPanel.field > TextBox, StackPanel.field > ComboBox, StackPanel.field > NumericUpDown, StackPanel.field > DockPanel > TextBox, StackPanel.field > DockPanel > NumericUpDown">
        <Setter Property="AutomationProperties.LabeledBy" Value="{Binding $parent[StackPanel].Children[0]}" />
    </Style>
    <!-- 数字框获得焦点的是模板里的输入框，名称也要给它 -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
        <Setter Property="AutomationProperties.LabeledBy" Value="{Binding $parent[NumericUpDown].(AutomationProperties.LabeledBy)}" />
    </Style>
    <!-- 开关的文字不随状态变化；文字在 OnContent 里，读屏取不到 -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OffContent" Value="{Binding $self.OnContent}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding $self.OnContent}" />
    </Style>
    <!-- 设置卡片由一行行设置组成，分隔线贯穿卡片 -->
    <Style Selector="Border.card.settings">
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Border.card.settings > StackPanel > TextBlock.section">
        <Setter Property="Margin" Value="16,14,16,10" />
    </Style>
    <Style Selector="ctl|SettingRow">
        <Style.Resources>
            <!-- 开关的文字就是行标题，不必给开关文字留出宽度和上下的空白 -->
            <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
            <GridLength x:Key="ToggleSwitchPreContentMargin">0</GridLength>
            <GridLength x:Key="ToggleSwitchPostContentMargin">0</GridLength>
        </Style.Resources>
    </Style>
    <!-- 模板在开关和文字之间固定留 12 像素，没有文字时用负边距让开关贴齐右边 -->
    <Style Selector="ctl|SettingRow ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>
    <Style Selector="ctl|SettingRow ComboBox">
        <Setter Property="MinWidth" Value="200" />
    </Style>
    <Style Selector="ctl|SettingRow NumericUpDown">
        <Setter Property="Width" Value="200" />
    </Style>
    <!-- 行里的控件没有自己的标签，读屏时念行标题和说明；要排在上面的 ToggleSwitch 样式之后 -->
    <Style Selector="ctl|SettingRow ToggleSwitch, ctl|SettingRow ComboBox, ctl|SettingRow NumericUpDown, ctl|SettingRow TextBox">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[ctl:SettingRow].Header}" />
        <Setter Property="AutomationProperties.HelpText" Value="{Binding $parent[ctl:SettingRow].Description}" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <ic:FluentIcon Icon="Search" FontSize="16" Margin="8,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 等宽数字，时间、速度这类逐秒变化的数字不再左右抖动，列也对得齐 -->
    <Style Selector="TextBlock.numeric">
        <Setter Property="FontFeatures" Value="+tnum" />
    </Style>
    <!-- 去掉 Fluent2 的卡片外观，融进表单；负边距让文字与表单对齐，同时悬停背景伸出两侧 -->
    <Style Selector="Expander.inline">
        <Style.Resources>
            <SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPointerOver" Color="{DynamicResource SubtleFillColorSecondary}" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundPressed" Color="{DynamicResource SubtleFillColorTertiary}" />
            <SolidColorBrush x:Key="ExpanderHeaderBackgroundDisabled" Color="Transparent" />
            <Thickness x:Key="ExpanderHeaderBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderHeaderPadding">8,0,0,0</Thickness>
            <Thickness x:Key="ExpanderContentDownBorderThickness">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">8,8,8,0</Thickness>
            <x:Double x:Key="ExpanderMinHeight">0</x:Double>
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="-8,0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- 警告再加 messageBanner 就变紧凑，靠后面的样式覆盖内边距 -->
    <Style Selector="Border.warningBanner, Border.errorBanner, Border.successBanner, Border.messageBanner">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    </Style>
    <Style Selector="Border.warningBanner">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.errorBanner, Border.successBanner, Border.messageBanner">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.errorBanner">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
    </Style>
    <Style Selector="Border.successBanner">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
    </Style>
    <Style Selector="Border.warningBanner > Grid > ic|FluentIcon">
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Border.successBanner > Grid > ic|FluentIcon">
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <!-- 错误可能有好几行，图标对齐第一行 -->
    <Style Selector="Border.errorBanner > Grid > ic|FluentIcon">
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="StackPanel.iconText">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.iconText > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.iconText > ic|FluentIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.table">
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.tableHeader TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style Selector="ListBox.table">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.table > ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector=":is(Button) > ic|FluentIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Theme" Value="{DynamicResource SubtleButton}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <!-- 主题的悬停、按下状态会把文字改回默认色，要一并覆盖 -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>
    <Style Selector="Button.critical /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
    </Style>
    <Style Selector="Button.critical:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style Selector="Button.critical:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <Style Selector="Button.critical:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
</Styles>
