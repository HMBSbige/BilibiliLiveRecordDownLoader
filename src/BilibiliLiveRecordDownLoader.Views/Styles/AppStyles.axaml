<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:ctl="using:BilibiliLiveRecordDownLoader.Views.Controls">
    <Styles.Resources>
        <Thickness x:Key="PageMargin">16</Thickness>
        <Thickness x:Key="CardPadding">16</Thickness>
        <x:Double x:Key="PageSpacing">24</x:Double>
        <x:Double x:Key="FormSpacing">12</x:Double>
        <x:Double x:Key="FieldSpacing">4</x:Double>
        <x:Double x:Key="ToolbarSpacing">8</x:Double>

        <ControlTheme x:Key="{x:Type ctl:EmptyState}" TargetType="ctl:EmptyState">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="Template">
                <ControlTemplate>
                    <StackPanel Spacing="8" MaxWidth="360">
                        <ic:FluentIcon Icon="{TemplateBinding Icon}" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText3}" />
                        <TextBlock Classes="section" Text="{TemplateBinding Title}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{TemplateBinding Description}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap"
                                   IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center" Margin="0,8,0,0"
                                          IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <Style Selector=":is(Panel).page">
        <Setter Property="Margin" Value="{StaticResource PageMargin}" />
    </Style>
    <Style Selector="StackPanel.page">
        <Setter Property="Spacing" Value="{StaticResource PageSpacing}" />
        <Setter Property="MaxWidth" Value="900" />
    </Style>
    <Style Selector="DockPanel.page">
        <Setter Property="VerticalSpacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="DockPanel.toolbar">
        <Setter Property="DockPanel.Dock" Value="Top" />
        <Setter Property="HorizontalSpacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.toolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector=":is(Panel).dialogFooter">
        <Setter Property="DockPanel.Dock" Value="Bottom" />
        <Setter Property="Margin" Value="0,24,0,0" />
    </Style>

    <!-- Semi 的卡片主题自带外边距，卡片会比同一页的横幅和状态行缩进一截 -->
    <Style Selector="Border.card">
        <Setter Property="Theme" Value="{DynamicResource CardBorder}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.form">
        <Setter Property="Spacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="Grid.form">
        <Setter Property="ColumnSpacing" Value="{StaticResource FormSpacing}" />
        <Setter Property="RowSpacing" Value="{StaticResource FormSpacing}" />
    </Style>
    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="{StaticResource FieldSpacing}" />
    </Style>
    <Style Selector="StackPanel.field > DockPanel, Grid.form > DockPanel">
        <Setter Property="HorizontalSpacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.field > TextBlock.caption">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 字段的第一个子元素是标签，读屏时随输入控件一起读出 -->
    <Style Selector="StackPanel.field > TextBox, StackPanel.field > ComboBox, StackPanel.field > NumericUpDown, StackPanel.field > DockPanel > TextBox, StackPanel.field > DockPanel > NumericUpDown">
        <Setter Property="AutomationProperties.LabeledBy" Value="{Binding $parent[StackPanel].Children[0]}" />
    </Style>
    <!-- 数字框获得焦点的是模板里的输入框，名称也要给它 -->
    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="AutomationProperties.Name" Value="{Binding $parent[NumericUpDown].(AutomationProperties.Name)}" />
        <Setter Property="AutomationProperties.LabeledBy" Value="{Binding $parent[NumericUpDown].(AutomationProperties.LabeledBy)}" />
    </Style>
    <!-- 开关的文字不随状态变化；文字在 OnContent 里，读屏取不到 -->
    <Style Selector="ToggleSwitch">
        <Setter Property="OffContent" Value="{Binding $self.OnContent}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding $self.OnContent}" />
    </Style>
    <Style Selector="TextBox.search">
        <Setter Property="InnerLeftContent">
            <Template>
                <ic:FluentIcon Icon="Search" FontSize="16" Margin="8,0,0,0" Foreground="{DynamicResource SemiColorText2}" />
            </Template>
        </Setter>
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeHeader6}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.caption, SelectableTextBlock.caption">
        <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- 负边距让文字与表单对齐，同时悬停背景伸出两侧 -->
    <Style Selector="Expander.inline">
        <Style.Resources>
            <Thickness x:Key="ExpanderHeaderMargin">0</Thickness>
            <Thickness x:Key="ExpanderContentPadding">8,8,8,0</Thickness>
            <SolidColorBrush x:Key="ExpanderSeparatorBorderBrush" Color="Transparent" />
        </Style.Resources>
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="-8,0" />
    </Style>

    <!-- 警告再加 messageBanner 就变紧凑，靠后面的样式覆盖内边距 -->
    <Style Selector="Border.warningBanner, Border.errorBanner, Border.successBanner, Border.messageBanner">
        <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
    </Style>
    <Style Selector="Border.warningBanner">
        <Setter Property="Background" Value="{DynamicResource SemiColorWarningLight}" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.errorBanner, Border.successBanner, Border.messageBanner">
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.errorBanner">
        <Setter Property="Background" Value="{DynamicResource SemiColorDangerLight}" />
    </Style>
    <Style Selector="Border.successBanner">
        <Setter Property="Background" Value="{DynamicResource SemiColorSuccessLight}" />
    </Style>
    <Style Selector="Border.warningBanner > Grid > ic|FluentIcon">
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorWarning}" />
    </Style>
    <!-- 错误可能有好几行，图标对齐第一行 -->
    <Style Selector="Border.errorBanner > Grid > ic|FluentIcon">
        <Setter Property="IconVariant" Value="Filled" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    </Style>
    <Style Selector="StackPanel.iconText">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{StaticResource ToolbarSpacing}" />
    </Style>
    <Style Selector="StackPanel.iconText > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.iconText > ic|FluentIcon">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.table">
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource SemiBorderRadiusMedium}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.tableHeader">
        <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.tableHeader TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource SemiFontSizeSmall}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    </Style>
    <Style Selector="ListBox.table">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.table > ListBoxItem">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector=":is(Button) > ic|FluentIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
</Styles>
